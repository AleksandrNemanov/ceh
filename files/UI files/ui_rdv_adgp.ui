  <property name="styleSheet">
   <string notr="true">QWidget {
    background-color: #1d1e21;
    color: #D0D0D0;
    font-family: Arial, sans-serif;
    font-size: 10.5pt;
}

/* Поля ввода */
QLineEdit, QTextEdit {
    background-color: #292929;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 5px;
    color: #E0E0E0;
}

QLineEdit:focus, QTextEdit:focus {
    border: 1px solid #666666;
}



/* Группы */
QGroupBox {
    border: 1px solid #444444;
    border-radius: 4px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 4px;
    font-size: 10pt;
    font-weight: bold;
    color: #A0A0A0;
}



/* Скроллбар */
QScrollBar:vertical {
    border: none;
    background: #222222;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #505050;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    background: none;
    border: none;
}

QPushButton {
    background-color: #2E2E2E; /* Основной цвет фона */
    color: #D0D0D0;
    border-radius: 5px; /* Скругленные углы */
    padding: 3px; /* Внутренние отступы */
    font-family: Arial, sans-serif; /* Шрифт */
    text-align: left;
    padding-left: 5px;
}

QPushButton:hover {
    background-color: #292929; /* Цвет фона при наведении */
}

QPushButton:pressed {
    background-color: #505050; /* Цвет фона при нажатии (темнее основного)232323 */
    padding-left: 4px; /* Сдвиг текста вправо при нажатии */
    padding-top: 8px; /* Сдвиг текста вниз при нажатии */
}
QPlainTextEdit{
  background-color: #3c3f41;
  color: #ffffff;
  border: 1px solid #444444;
  padding: 2px 1px;

}
</string>
